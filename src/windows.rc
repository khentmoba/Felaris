#include <windows.h>
1 ICON "assets/icon.ico"
1 VERSIONINFO
FILEVERSION APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Felaris Browser\0"
            VALUE "FileDescription", "Felaris Browser\0"
            VALUE "FileVersion", APP_VERSION "\0"
            VALUE "InternalName", "felaris\0"
            VALUE "OriginalFilename", "felaris.exe\0"
            VALUE "ProductName", "Felaris\0"
            VALUE "ProductVersion", APP_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
