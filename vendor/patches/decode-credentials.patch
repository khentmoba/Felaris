+/// Builds a Basic `Authorization` header from the credentials in `url`. URLs store
+/// credentials percent-encoded (including ones the embedder supplied for an
+/// authentication request), so they are decoded before being sent.
+pub(crate) fn basic_from_url(url: &ServoUrl) -> Authorization<Basic> {
+    let decode = |part: &str| percent_decode_str(part).decode_utf8_lossy().into_owned();
+    Authorization::basic(
+        &decode(url.username()),
+        &decode(url.password().unwrap_or("")),
+    )
+}
