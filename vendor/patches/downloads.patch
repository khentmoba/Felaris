+/// A top-level navigation in a [`WebView`] led to a download: the response is an attachment,
+/// or Servo cannot display its content type. The current page stays. Call
+/// [`DownloadRequest::save_to`] to save the response; dropping the request discards it.
+pub struct DownloadRequest {
+    pub(crate) details: DownloadDetails,
+    pub(crate) responder: AutomaticResponder<Option<PathBuf>>,
+    pub(crate) error_sender: ServoErrorSender,
+}
+
+impl DownloadRequest {
+    pub(crate) fn new(
+        details: DownloadDetails,
+        response_sender: Sender<Option<PathBuf>>,
+        error_sender: ServoErrorSender,
+    ) -> Self {
+        Self {
+            details,
+            responder: AutomaticResponder::new_same_process(
+                Box::new(OneshotSender::from(response_sender)),
+                None,
+            ),
+            error_sender,
+        }
+    }
+
+    /// The URL of the response being downloaded.
+    pub fn url(&self) -> &Url {
+        self.details.url.as_url()
+    }
+    /// The file name the server suggested, or the last segment of the URL. It is not
+    /// sanitized and may contain path separators.
+    pub fn suggested_filename(&self) -> &str {
+        &self.details.suggested_filename
+    }
+    /// The essence of the response's MIME type, if it declared one.
+    pub fn mime_type(&self) -> Option<&str> {
+        self.details.mime_type.as_deref()
+    }
+    /// The response's `Content-Length`, if known.
+    pub fn content_length(&self) -> Option<u64> {
+        self.details.content_length
+    }
+    /// Save the response to `path`, replacing any file there.
+    /// [`WebViewDelegate::notify_download_finished`] reports the outcome.
+    pub fn save_to(mut self, path: PathBuf) {
+        if let Err(error) = self.responder.send(Some(path)) {
+            self.error_sender.raise_response_send_error(error);
+        }
+    }
+}
