+    /// Removes the entries whose key matches `matches`.
+    /// Should only be called in sync context and will panic.
+    pub(crate) fn remove_matching(&self, matches: impl Fn(&CacheKey) -> bool) {
+        let mut inner = self.inner.blocking_lock();
+        let mut keys_to_delete = vec![];
+        let mut removed_size = 0;
+        inner.entries.retain(|metadata| {
+            if !matches(&metadata.key) {
+                return true;
+            }
+            removed_size += metadata.size;
+            keys_to_delete.push(metadata.key.clone());
+            false
+        });
+        if keys_to_delete.is_empty() {
+            return;
+        }
+        inner.size = inner.size.saturating_sub(removed_size);
+        let keys_ref = keys_to_delete.iter().map(|key| key.as_ref());
+        let (query, values) = Query::delete()
+            .from_table(DiskCacheTable::Table)
+            .and_where(Expr::col(DiskCacheTable::Key).is_in(keys_ref))
+            .build_rusqlite(SqliteQueryBuilder);
+        if inner
+            .db
+            .execute(query.as_str(), &*values.as_params())
+            .is_err()
+        {
+            error!("Could not remove disk cache entries");
+        }
+    }
+
     /// Clears the disk cache.
     /// Should only be called in sync context and will panic.
     #[servo_tracing::instrument(skip(self))]
